skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
title BLL.Tests: модульні тести

class AdServiceTests {
  18 тестів
}
class CategoryServiceTests {
  6 тестів
}
class UserAndTagServiceTests {
  6 тестів
