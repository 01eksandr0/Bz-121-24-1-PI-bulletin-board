@startuml
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam componentStyle rectangle
title Загальна архітектура рішення BulletinBoard

package "Рівень представлення (UI)" #ECEFF1 {
  [BulletinBoard.ConsoleUI] as UI
  [WinForms / WPF / Web UI\n(можливе розширення)] as UI2 #white
}
package "Рівень бізнес-логіки (BLL)" #F3E5F5 {
  [BulletinBoard.BLL\nсервіси, моделі, mapping] as BLL
}
package "Рівень доступу до даних (DAL)" #E3F2FD {
  [BulletinBoard.DAL.Abstractions\nсутності, IRepository<T>, IUnitOfWork] as ABS
  [BulletinBoard.DAL.EF\nEF Core Code First, SQLite] as EF
  [DAL.Json / DAL.Mongo\n(можливе розширення)] as OTHER #white
}
database "board.db\n(SQLite)" as DB

UI --> BLL : IUserService, IAdService ...\nмоделі BLL
UI2 ..> BLL
BLL --> ABS : IUnitOfWork\nсутності DAL
EF ..|> ABS : реалізує
OTHER ..|> ABS : реалізує
EF --> DB
UI ..> EF : тільки Program.cs\n(точка збирання)
@enduml
