@startuml
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam componentStyle rectangle
title Загальна архітектура рішення BulletinBoard (лаб. 2.4)

actor "Postman / браузер /\nбудь-який UI" as Client
package "Рівень представлення (PL)" #ECEFF1 {
  [BulletinBoard.WebAPI\nконтролери, моделі PL, фільтри] as API
  [BulletinBoard.ConsoleUI\n(з лаб. 2.2)] as CON
}
package "Інфраструктура (DI)" #FFF8E1 {
  [BulletinBoard.Infrastructure\nAutofac: DataAccessModule,\nBusinessLogicModule] as INF
}
package "Рівень бізнес-логіки (BLL)" #F3E5F5 {
  [BulletinBoard.BLL\nсервіси, моделі, mapping] as BLL
}
package "Рівень доступу до даних (DAL)" #E3F2FD {
  [BulletinBoard.DAL.Abstractions\nсутності, IRepository<T>, IUnitOfWork] as ABS
  [BulletinBoard.DAL.EF\nEF Core Code First] as EF
}
package "Тести" #E8F5E9 {
  [BulletinBoard.BLL.Tests\nxUnit, UoW у пам'яті] as TST
}
database "board.db\n(SQLite)" as DB

Client --> API : HTTP + JSON
API --> BLL : I*Service, моделі BLL
API ..> INF : реєстрація модулів\n(Program.cs)
INF ..> BLL : реєструє сервіси
INF ..> EF : реєструє IUnitOfWork
CON --> BLL
BLL --> ABS : IUnitOfWork
EF ..|> ABS : реалізує
EF --> DB
TST --> BLL
TST ..> ABS : InMemoryUnitOfWork
@enduml
